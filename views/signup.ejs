<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sign Up — Scraplet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/dashboard/css/neo-pulp.css?v=10">
</head>

<body class="np min-h-screen flex items-center justify-center bg-transparent text-white p-6">
  <div class="pc-panel w-full max-w-md">
    <div class="pc-panel-hd">
      <div class="pc-panel-title">New Identity Registration</div>
    </div>
    <div class="pc-panel-bd">

    <form
      action="/auth/signup<%= embed ? '?embed=1' : '' %>"
      method="POST"
      class="space-y-4"
    >
      <% if (embed) { %>
        <input type="hidden" name="embed" value="1" />
      <% } %>

      <input
        type="email"
        name="email"
        placeholder="Email"
        required
        class="pc-input"
        autocomplete="email"
      />

      <input
        type="text"
        name="username"
        placeholder="Username"
        required
        class="pc-input"
        autocomplete="username"
      />

      <input
        type="password"
        name="password"
        placeholder="Password"
        required
        class="pc-input"
        autocomplete="new-password"
      />

      <button
        type="submit"
        class="pc-btn pc-btn--primary w-full"
      >
        Initialize Account
      </button>
    </form>

    <div class="mt-6 text-sm pc-text-muted text-center border-t border-black/5 pt-4">
      <span>Existing credentials detected?</span>
      <a
        href="/auth/login<%= embed ? '?embed=1' : '' %>"
        class="text-cyan-400 hover:underline font-bold"
      >Log in</a>
    </div>
  </div>
</div>
</body>
</html>
