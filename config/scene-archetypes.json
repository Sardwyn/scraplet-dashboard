{
  "archetypes": {
    "just_chatting": {
      "displayName": "Just Chatting",
      "description": "Optimized for creator-to-audience interaction with large camera views and readable chats.",
      "variants": {
        "immersive": {
          "displayName": "Immersive Floating",
          "description": "Full-bleed webcam background with semi-transparent widgets floating on top.",
          "elements": [
            {
              "type": "shape",
              "name": "Webcam Background Border",
              "anchorZone": "CENTER_HUD",
              "widthPct": 100,
              "heightPct": 100,
              "style": {
                "shapeType": "box",
                "backgroundColor": "rgba(0, 0, 0, 0)",
                "borderWidthPx": 8,
                "borderColorKey": "accentColor"
              }
            },
            {
              "type": "lower_third",
              "name": "Social Handle Event Banner",
              "anchorZone": "BOTTOM_LEFT",
              "widthPct": 30,
              "heightPct": 12,
              "style": {
                "title": "Welcome to the Stream!",
                "subtitle": "Follow @Sardwyn repos",
                "alwaysOn": true,
                "layoutMode": "split",
                "variant": "accent-bar"
              }
            },
            {
              "type": "lower_third",
              "name": "Floating Stream Chat Monitor",
              "anchorZone": "BOTTOM_RIGHT",
              "widthPct": 25,
              "heightPct": 45,
              "style": {
                "title": "Live Stream Chat",
                "subtitle": "Waiting for messages...",
                "alwaysOn": true,
                "layoutMode": "stacked",
                "variant": "glass"
              }
            }
          ]
        },
        "framed_split": {
          "displayName": "Cozy Framed Split",
          "description": "Classic panel-based layout with dedicated spaces for camera, chat, and telemetry.",
          "elements": [
            {
              "type": "shape",
              "name": "Wallpaper Backdrop",
              "anchorZone": "CENTER_HUD",
              "widthPct": 100,
              "heightPct": 100,
              "style": {
                "shapeType": "box",
                "backgroundColorKey": "bgColor"
              }
            },
            {
              "type": "shape",
              "name": "Camera Framing Box",
              "anchorZone": "MIDDLE_LEFT",
              "widthPct": 65,
              "heightPct": 75,
              "style": {
                "shapeType": "box",
                "backgroundColorKey": "panelColor",
                "borderWidthPx": 4,
                "borderColorKey": "accentColor"
              }
            },
            {
              "type": "text",
              "name": "Webcam Label",
              "anchorZone": "TOP_LEFT",
              "widthPct": 30,
              "heightPct": 8,
              "style": {
                "text": "CREATOR FEED",
                "fontSizePx": 32,
                "colorKey": "textColor"
              }
            },
            {
              "type": "lower_third",
              "name": "Structured Chat Panel",
              "anchorZone": "MIDDLE_RIGHT",
              "widthPct": 28,
              "heightPct": 75,
              "style": {
                "title": "Stream Chat",
                "subtitle": "Be nice in chat!",
                "alwaysOn": true,
                "layoutMode": "stacked",
                "variant": "solid"
              }
            },
            {
              "type": "progress_bar",
              "name": "Top Header Goal Tracker",
              "anchorZone": "TOP_CENTER",
              "widthPct": 40,
              "heightPct": 8,
              "style": {
                "name": "Subscriber Goal",
                "bindingSourceId": "custom_variables",
                "bindingFieldId": "sub_goal_progress",
                "bindingFallback": 0.75,
                "direction": "ltr"
              }
            }
          ]
        }
      }
    },
    "gameplay": {
      "displayName": "In-Game HUD",
