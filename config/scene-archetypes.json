              "anchorZone": "BOTTOM_RIGHT",
              "widthPct": 25,
              "heightPct": 12,
              "style": {
                "title": "YOUTUBE",
                "subtitle": "/c/SardwynStream",
                "alwaysOn": true,
                "layoutMode": "split",
                "variant": "solid"
              }
            }
