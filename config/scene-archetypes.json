    "starting_soon": {
      "displayName": "Starting Soon",
      "description": "Hyping up the broadcast with countdown timers, schedule summaries, and upbeat theme styles.",
      "variants": {
        "centered": {
          "displayName": "Symmetric Centered Countdown",
          "description": "Bold center title paired with a circular countdown ring and left/right social handle cards.",
          "elements": [
            {
              "type": "shape",
              "name": "Symmetric Wallpaper",
              "anchorZone": "CENTER_HUD",
              "widthPct": 100,
              "heightPct": 100,
              "style": {
                "shapeType": "box",
                "backgroundColorKey": "bgColor"
              }
            },
            {
              "type": "text",
              "name": "Main Hype Title",
              "anchorZone": "TOP_CENTER",
              "widthPct": 50,
              "heightPct": 15,
              "style": {
                "text": "BROADCAST STARTING SOON",
                "fontSizePx": 64,
                "colorKey": "textColor"
